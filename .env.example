# Бандл әдепкі күйде ЕШҚАНДАЙ баптаусыз жұмыс істейді.
# Драфт көшіріп-қоюға дайын блок болып қайтады.
#
# Төмендегілердің бәрі — қаласаң қосатын нәрсе.

# ---------------------------------------------------------------------------
# Threads-тің ресми API-ы (ұсынылатын жол)
# ---------------------------------------------------------------------------
# Не береді:
#   * посттың статистикасы автоматты тартылады, қолмен теру керек емес
#   * пост API арқылы жарияланады
#
# Қалай алынады:
#   1. https://developers.facebook.com — қосымша тіркеу, Threads API қосу
#   2. Рұқсаттар — ЕҢ АЗЫН ҒАНА сұра:
#        threads_basic            — посттар тізімі
#        threads_manage_insights  — посттың сандары
#        threads_content_publish  — ТЕК автопост қалсаң
#      Автопост керек болмаса, үшіншісін сұрама: сонда токен ұрланса да,
#      онымен сенің атыңнан ештеңе жарияланбайды. Толығырақ: SECURITY.md
#   3. Ұзақ мерзімді токен алу
#
# THREADS_TOKEN=THAA...
#
# Немесе файлға сақтау (ол .gitignore ішінде):
#   python3 -m lib.threads_api token THAA...

# ---------------------------------------------------------------------------
# Мақұлдаусыз жариялау
# ---------------------------------------------------------------------------
# Қосылса: тексеруден ТОЛЫҚ өткен драфт өзі жарияланады.
# Бір ғана қате шықса — тоқтайды да, саған көрсетеді.
# Жауап пен дәйексөз бұл режимде де ешқашан автоматты жарияланбайды.
#
# THREADS_AVTO=1

# ---------------------------------------------------------------------------
# Өз жариялау командаң (API-дың орнына)
# ---------------------------------------------------------------------------
# Драфт stdin арқылы JSON пішімінде беріледі:
#   {"turi": "post", "mati": "...", "nysana_url": "..."}
# Команда 0 қайтарса — сәтті.
#
# THREADS_POSTER="python3 менің_постерім.py"

# ---------------------------------------------------------------------------
# Файлдардың орны (әдепкіден басқа болса)
# ---------------------------------------------------------------------------
# THREADS_JURNAL=.threads-jurnal.jsonl
# THREADS_PROFIL=.threads-profil.md
# THREADS_TOKEN_FILE=.threads-token.json
